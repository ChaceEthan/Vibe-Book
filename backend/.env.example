MONGO_URI=
JWT_SECRET=
PORT=5000
CLIENT_URL=
FRONTEND_URL=https://vibe-book-kappa.vercel.app
NEX_POINTS_PER_COIN=1000

# Email OTP delivery. Gmail requires a Google App Password, not your regular Gmail password.
# EMAIL_USER / EMAIL_PASS / FROM_EMAIL are preferred; SMTP_EMAIL / SMTP_PASSWORD / SMTP_FROM still work.
EMAIL_USER=
EMAIL_PASS=
FROM_EMAIL="VibeBook <your-gmail-address@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM="VibeBook <your-gmail-address@gmail.com>"
OTP_EXPIRES_MINUTES=10

# Optional phone OTP provider. Leave SMS_PROVIDER empty to keep phone verification disabled in production.
# Supported values: twilio, vonage, africastalking
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_FROM can also be provided as SMS_FROM.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=VibeBook
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=
