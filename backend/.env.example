MONGO_URI=
JWT_SECRET=
PORT=5000
CLIENT_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
SERVER_URL=https://api.example.com
LIVE_STREAM_URL=https://api.example.com
SOCKET_PATH=/socket.io
CORS_ORIGIN=https://app.example.com
NEX_POINTS_PER_COIN=1000

# Email OTP delivery via Resend.
RESEND_API_KEY=
FROM_EMAIL=no-reply@example.com
OTP_EXPIRES_MINUTES=5
PHONE_AUTH_STATUS=COMING_SOON

# Optional phone OTP provider. Leave SMS_PROVIDER empty to keep phone verification disabled in production.
# Supported values: twilio, vonage, africastalking
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_FROM can also be provided as SMS_FROM.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=VibeBook
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=
